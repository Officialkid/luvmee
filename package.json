{
  "name": "luvmee-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LUVMEE (Love Me) — Mobile-first personalized romantic experience platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=@luvmee/shared run build",
    "test:shared": "npm --workspace=@luvmee/shared test",
    "dev:alika": "node server.js",
    "dev:web": "npm --workspace=recipient-web run dev",
    "dev:mobile": "npm --workspace=luvmee-mobile start",
    "build:web": "npm --workspace=recipient-web run build"
  },
  "keywords": [
    "luvmee",
    "romantic",
    "experience",
    "react-native",
    "nextjs",
    "supabase"
  ],
  "license": "MIT"
}
