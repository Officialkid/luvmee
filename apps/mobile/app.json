{
  "expo": {
    "name": "LUVMEE",
    "slug": "luvmee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "luvmee",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FCE7ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.officialkid.luvmee"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCE7ED"
      },
      "package": "com.officialkid.luvmee",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52a47cbe-9b37-4109-a9ea-28236e6d40f8"
      }
    },
    "owner": "dan.mwaili"
  }
}
